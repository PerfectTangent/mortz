<?xml version="1.0" encoding="UTF-8"?>
<!-- Default shortcuts for the Mortz actions. Rebind them in Settings > Configure Krita >
     Keyboard Shortcuts. Names match actions.ALL. -->
<ActionCollection version="2" name="Scripts">
